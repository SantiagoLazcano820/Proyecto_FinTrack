          "name": "POST api/Token (Login Santiago - Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set(\"token\", jsonData.token);",
                  "    console.log(\"Token JWT guardado automáticamente en la variable de colección.\");",
                  "}"
